#!/usr/bin/env python3
"""nightshift CLI —  ./ns <command>"""
import argparse, json, subprocess, sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
from nightshift import config, episodes, fleet, store

def cmd_proxy(a):
    import uvicorn
    print(f"ingest proxy → {config.UPSTREAM_BASE}\n"
          f"  export OPENAI_BASE_URL=http://localhost:{a.port}/v1\n"
          f"  export ANTHROPIC_BASE_URL=http://localhost:{a.port}\n")
    uvicorn.run("nightshift.proxy:app", host="0.0.0.0", port=a.port, log_level="warning")

def cmd_status(a):
    from nightshift.dispersed import request
    s, me = request("GET", "/v1/users/me")
    print(f"account   : {me.get('email')}  ({s})")
    s2, b = request("GET", f"/v1/accounts/{me['uuid']}/balance")
    print(f"balance   : {b.get('available_balance')} {b.get('currency')}")
    print(f"captured  : {sum(store.stats().values())} calls over {len(store.stats())} day(s)")
    eps = episodes.collect(limit_sessions=a.limit_sessions or None)
    print(f"episodes  : {len(eps)} judgeable")
    runs = [r for r in fleet.all_runs() if r.get("status") in ("RUNNING","PREPARING","ASSIGNED")]
    print(f"live runs : {len(runs)}")
    for r in runs:
        print(f"   {r['uuid'][:8]} {r['status']:<10} ${r.get('hourly_rate_usd')}/hr")

def cmd_run(a):
    from nightshift.batch import run_batch
    out = run_batch(fleet_size=a.fleet, limit_episodes=a.limit or None,
                    limit_sessions=a.limit_sessions or None, keep_alive=a.keep_alive, day=a.day,
                    use_claude_code=not a.day,   # --day = that day's captured traffic only
                    reuse=True if a.reuse else None, endpoint=a.endpoint)
    print(out.get("markdown") or out)

def cmd_warm(a):
    """Pre-warm a fleet and LEAVE IT UP. Run this before the demo."""
    from nightshift import config
    jobs = fleet.cook(n=a.fleet, title_suffix="warm")
    quorum = max(1, int(a.fleet * 0.6))
    eps, timings = fleet.wait_ready(jobs, timeout_s=1800, poll_s=10, need=quorum, grace_s=300)
    if not eps:
        fleet.teardown(jobs); sys.exit("no nodes came up")
    fleet.save_pool(eps, jobs)
    fleet._LIVE.clear()   # deliberately keep them alive
    print(f"\nWARM: {len(eps)}/{a.fleet} nodes ready "
          f"({', '.join(f'{v:.0f}s' for v in timings.values())})")
    for e in eps: print("  ", e["base"])
    print(f"\ncost while idle: ${0.69*len(eps):.2f}/hr — run './ns kill' when done")

def cmd_pool(a):
    eps, jobs = fleet.load_pool()
    print(f"warm pool: {len(eps)} healthy node(s)")
    for e in eps: print("  ", e["base"])

def cmd_show(a):
    """Show the raw material: what actually gets shipped to the GPUs."""
    from nightshift import store, episodes
    import textwrap
    days = store.days()
    print("\033[1mCAPTURED TRAFFIC\033[0m  (data/traces/)")
    if not days:
        print("  nothing captured yet — run ./ns proxy")
    for d in days:
        print(f"  {d}.jsonl    {sum(1 for _ in open(store.path_for(d))):>5} LLM calls")
    print()
    eps = episodes.collect(day=a.day, use_claude_code=not a.day,
                           limit_sessions=a.limit_sessions or None)
    print(f"\033[1mTASK EPISODES\033[0m  {len(eps)} judgeable units")
    projects = {}
    for e in eps:
        projects[e["project"]] = projects.get(e["project"], 0) + 1
    for k, v in sorted(projects.items(), key=lambda x: -x[1])[:8]:
        print(f"  {v:>5}  {k}")
    print()
    for e in eps[:a.n]:
        print("\033[1m" + "─" * 74 + "\033[0m")
        print(f"\033[1mid\033[0m       {e['id']}")
        print(f"\033[1mproject\033[0m  {e['project']}   ({e['n_turns']} turns, {e['chars']} chars)")
        print(f"\033[1mrequest\033[0m  {textwrap.shorten(e['request'], 300)}")
        body = e["transcript"][:a.chars].replace("\n", "\n         ")
        print(f"\033[1mtrace\033[0m    {body}...")
    print("\033[1m" + "─" * 74 + "\033[0m")
    print(f"\nEach of these {len(eps)} episodes becomes ONE judged GPU call.")


def cmd_demo(a):
    """Scripted walkthrough: corpus -> fleet -> burst -> report."""
    import subprocess, sys as _s, time
    R = str(Path(__file__).resolve().parent)
    def step(n, title):
        print(f"\n\033[1;7m  {n}  {title}  \033[0m\n")
        if not a.no_pause:
            try: input("      [enter to run] ")
            except EOFError: pass
    step(1, "THE RAW MATERIAL — what we captured")
    subprocess.run([_s.executable, f"{R}/ns", "show", "--n", "2", "--chars", "700"])
    step(2, "THE FLEET — GPUs rented on the Dispersed network")
    subprocess.run([_s.executable, f"{R}/ns", "pool"])
    step(3, "THE BURST — judge every episode, in parallel, on rented GPUs")
    cmd = [_s.executable, f"{R}/ns", "run", "--reuse"]
    if a.limit: cmd += ["--limit", str(a.limit)]
    if a.day: cmd += ["--day", a.day]
    subprocess.run(cmd)
    step(4, "THE REPORT")
    subprocess.run([_s.executable, f"{R}/ns", "report"])


def cmd_report(a):
    p = config.RUNS / "latest"
    if not p.exists(): sys.exit("no runs yet")
    d = Path(p.read_text().strip())
    print((d / "report.md").read_text())
    print(f"\nhtml: {d/'report.html'}")

def cmd_kill(a):
    killed = fleet.reconcile()
    print(f"cancelled {len(killed)} job(s)" if killed else "nothing running")

def cmd_sched(a):
    subprocess.run([sys.executable, "-m", "nightshift.scheduler", "--at", a.at])

p = argparse.ArgumentParser(prog="ns", description="nightshift — batch LLM observability on Dispersed")
sub = p.add_subparsers(dest="cmd", required=True)
sp = sub.add_parser("proxy", help="run the ingest proxy"); sp.add_argument("--port", type=int, default=config.PROXY_PORT); sp.set_defaults(f=cmd_proxy)
sp = sub.add_parser("status", help="account, corpus and live GPU state"); sp.add_argument("--limit-sessions", type=int, default=0); sp.set_defaults(f=cmd_status)
sp = sub.add_parser("run", help="run a batch now"); sp.add_argument("--fleet", type=int, default=None); sp.add_argument("--limit", type=int, default=0); sp.add_argument("--limit-sessions", type=int, default=0); sp.add_argument("--keep-alive", action="store_true"); sp.add_argument("--reuse", action="store_true", help="use the pre-warmed fleet"); sp.add_argument("--endpoint", default=None, help="explicit OpenAI-compatible base URL; provisions no GPUs"); sp.add_argument("--day", default=None); sp.set_defaults(f=cmd_run)
sp = sub.add_parser("warm", help="pre-warm a fleet and keep it up (do this BEFORE the demo)"); sp.add_argument("--fleet", type=int, default=4); sp.set_defaults(f=cmd_warm)
sp = sub.add_parser("pool", help="show the warm pool"); sp.set_defaults(f=cmd_pool)
sp = sub.add_parser("show", help="show the corpus that gets shipped to the GPUs"); sp.add_argument("--n", type=int, default=3); sp.add_argument("--chars", type=int, default=900); sp.add_argument("--day", default=None); sp.add_argument("--limit-sessions", type=int, default=0); sp.set_defaults(f=cmd_show)
sp = sub.add_parser("demo", help="scripted walkthrough for presenting"); sp.add_argument("--limit", type=int, default=0); sp.add_argument("--day", default=None); sp.add_argument("--no-pause", action="store_true"); sp.set_defaults(f=cmd_demo)
sp = sub.add_parser("report", help="show the last report"); sp.set_defaults(f=cmd_report)
sp = sub.add_parser("kill", help="cancel every nightshift GPU job"); sp.set_defaults(f=cmd_kill)
sp = sub.add_parser("schedule", help="run nightly"); sp.add_argument("--at", default="02:00"); sp.set_defaults(f=cmd_sched)
a = p.parse_args(); a.f(a)
